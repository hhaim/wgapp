# Deployment settings only. Never put WireGuard keys or profiles here.
FLY_APP=my-wg-relay
FLY_ORG=personal
FLY_REGION=iad
WGPROXY_DOMAIN=relay.example.com
WGPROXY_USERNAME=relay-user
# Generated once by ./b publish_flyio; keep this value to preserve client access.
WGPROXY_PASSWORD=
WGPROXY_UDP_PORT=51820
# Optional comma-separated GOST hostname wildcards (for example *.example.net).
WGPROXY_ALLOWED_DOMAINS=*
